{
  "manifest_version": 3,
  "name": "IC Horus - Scam Detect",
  "version": "1.2.0",
  "description": "Monitora mensagens do WhatsApp Web para detectar tentativas de golpe.",
  "icons": {
    "16": "util/logo_recod.png",
    "48": "util/logo_recod.png",
    "128": "util/logo_recod.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5500/*",
    "http://localhost:5500/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["interface.css"],
      "js": ["triggers.js", "annotation_utils.js", "interface.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["util/logo_recod.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "permissions": [
    "storage"
  ]
}
